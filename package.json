{
  "name": "ops-ticket-system",
  "private": true,
  "version": "1.0.0",
  "description": "Operations Support Portal: a small ticketing system for operations teams, built for Vercel.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env.local scripts/dev-server.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "build:vercel": "tsx scripts/migrate.ts --if-configured && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/admin.ts create",
    "admin:reset-password": "tsx --env-file-if-exists=.env.local scripts/admin.ts reset-password"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.15.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
