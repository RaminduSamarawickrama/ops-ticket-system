# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project → Settings → Environment Variables.

# --- Database (required) ---------------------------------------------------------------------
# Neon Postgres. Use the POOLED connection string (host contains "-pooler").
# If you add Neon through the Vercel Marketplace, DATABASE_URL is set for you.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Email (required for notifications) ------------------------------------------------------
# Resend API key (https://resend.com/api-keys). Server-side only.
EMAIL_PROVIDER_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender on a domain you have verified in Resend.
EMAIL_FROM=Operations Support <support@yourdomain.example>
# Who receives new-ticket alerts. One address, or several separated by commas.
OPERATIONS_NOTIFICATION_EMAIL=operations@example.com,supervisor@example.com

# --- Links and time zone ---------------------------------------------------------------------
# Public URL of the deployed site, used for the dashboard link in emails.
# On Vercel this falls back to the production domain if left empty.
APP_BASE_URL=https://your-project.vercel.app
# Time zone used for timestamps in emails (IANA name). Defaults to UTC.
APP_TIMEZONE=Asia/Colombo

# --- Screenshot storage ----------------------------------------------------------------------
# Connecting a PRIVATE Vercel Blob store to the project adds its credentials automatically.
# For local development against the real store, run `vercel env pull .env.local`, or set:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# --- Optional --------------------------------------------------------------------------------
# Admin session length in hours (default 12, max 168).
# SESSION_TTL_HOURS=12

# Local development only (ignored in production):
# EMAIL_DRY_RUN=true      # print emails to the terminal instead of sending them
# STORAGE_DRIVER=local    # keep screenshots in ./.local-storage instead of Vercel Blob
